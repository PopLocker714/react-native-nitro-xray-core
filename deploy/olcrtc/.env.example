# Copy to .env and fill in. `docker compose` reads this automatically.

# Prebuilt image to pull (defaults to jojo714/olcrtc:latest in the compose).
OLCRTC_IMAGE=jojo714/olcrtc:latest

# Carrier: wbstream | telemost | jitsi. wbstream works (anonymous guest, verified)
# and is RF-whitelisted. jitsi is NOT usable — meet.jit.si now requires a JWT.
OLCRTC_CARRIER=wbstream

# Transport — MUST match the mobile client. wbstream/telemost need vp8channel
# (datachannel doesn't work on them). vp8channel is the client's native default.
OLCRTC_TRANSPORT=vp8channel

# For wbstream, room = the room ID created on https://stream.wb.ru
OLCRTC_ROOM_ID=


# Leave empty to auto-generate on first run (printed to logs, saved to the
# volume). Paste the generated 64-hex value here to pin it, and into the
# mobile client's OlcrtcClientConfig.keyHex.
OLCRTC_KEY=

# Optional
OLCRTC_DNS=8.8.8.8:53
OLCRTC_DEBUG=false
