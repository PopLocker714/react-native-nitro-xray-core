# Copy to .env and fill in. `docker compose` reads this automatically.

# Prebuilt image to pull (build + push it from a dev box first — see README).
OLCRTC_IMAGE=youruser/olcrtc:latest

# Whitelisted carrier the side-channel paras on: jitsi | telemost | wbstream
OLCRTC_CARRIER=wbstream

# Transport — MUST match the mobile client. Native client defaults to vp8channel.
OLCRTC_TRANSPORT=vp8channel

# Room both sides join on the carrier. For wbstream: the room ID from stream.wb.ru.
# For jitsi/telemost: the meeting URL (e.g. https://meet.cryptopro.ru/myroom).
OLCRTC_ROOM_ID=

# Leave empty to auto-generate on first run (printed to logs, saved to the
# volume). Paste the generated 64-hex value here to pin it, and into the
# mobile client's OlcrtcClientConfig.keyHex.
OLCRTC_KEY=

# Optional
OLCRTC_DNS=8.8.8.8:53
OLCRTC_DEBUG=false
