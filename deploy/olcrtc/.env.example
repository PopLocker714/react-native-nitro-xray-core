# Copy to .env and fill in. `docker compose` reads this automatically.

# Prebuilt image to pull (defaults to jojo714/olcrtc:latest in the compose).
OLCRTC_IMAGE=jojo714/olcrtc:latest

# Whitelisted carrier: jitsi | telemost | wbstream. jitsi = fastest, no signup.
OLCRTC_CARRIER=jitsi

# Transport — MUST match the mobile client. datachannel is fastest and stable
# with jitsi. Pass transport:'datachannel' in the mobile startOlcrtc too.
OLCRTC_TRANSPORT=datachannel

# For jitsi, room = the FULL meeting URL (public meet.jit.si or self-hosted).
OLCRTC_ROOM_ID=https://meet.jit.si/your-unique-room

# Leave empty to auto-generate on first run (printed to logs, saved to the
# volume). Paste the generated 64-hex value here to pin it, and into the
# mobile client's OlcrtcClientConfig.keyHex.
OLCRTC_KEY=

# Optional
OLCRTC_DNS=8.8.8.8:53
OLCRTC_DEBUG=false
